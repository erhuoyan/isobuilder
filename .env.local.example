# 本地测试环境变量：复制为 .env.local（chmod 600），compose 用 --env-file 读。
#
# 为什么这里用环境变量而不是 config.yaml：
# 某些 JDOS 制品（例如 v20261017.114652）的二进制不解析 -c，只认环境变量。
# 本地由我们自己传，不存在平台注入不可控的问题，所以两条路都留着最稳。

# MySQL（URL 形式，密码里的 @ 写成 %40）
ISOBUILDER_DB_URL=mysql://isobuilder:REPLACE_PASSWORD@mysql-internet-cn-north-1-415a1725ad4e4162.rds.jdcloud.com:3306/isobuilder

# PostgreSQL（URL 形式）：
# ISOBUILDER_DB_URL=postgres://user:pass@host:5432/isobuilder?sslmode=prefer
# PostgreSQL（key=value 形式）：
# ISOBUILDER_DB_URL=host=204.1.2.3 port=5432 user=isobuilder password=secret dbname=isobuilder sslmode=prefer

# 留空则不传，退回容器内 SQLite。
