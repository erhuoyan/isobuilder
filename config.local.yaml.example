# 通用单容器部署的配置模板：复制为 config.local.yaml 后修改。
#
#   cp config.local.yaml.example config.local.yaml
#   chmod 600 config.local.yaml        # 若在里面写了数据库密码
#   docker compose up -d
#
# 这是唯一的配置来源（compose 用 -c 挂进容器）。对象存储也可以只在
# Web「系统配置」页维护——那里存数据库，优先级高于本文件的种子值。
#
# 值里若含 # 或以 : 开头，要用引号包起来（YAML 语法）。

# 监听地址，Go 的 "host:port" 形式。冒号前留空 = 绑定所有网卡，
# 容器部署必须如此（写 127.0.0.1:8080 会导致端口映射访问不到）。
addr: ":8080"

# 数据根目录；isos/uploads/work/builds/kickstarts/artifacts 与
# isobuilder.db 都由它派生，子目录不单独配置。
data_dir: /opt/isobuilder/data

# 数据库（三选一；留空 = 容器内 SQLite）：
#   database_url: 'postgres://user:pass@host:5432/isobuilder?sslmode=prefer'
#   database_url: 'host=<host> port=5432 user=<user> password=<pass> dbname=isobuilder sslmode=prefer'
#   database_url: 'mysql://user:pass@host:3306/isobuilder'
# 也可以留空，把连接串放进环境变量 ISOBUILDER_DB_URL。
# database_url: ""

# 鉴权令牌；留空 = 不鉴权。
# auth_token: ""

# 构建参数
# max_concurrent_builds: 1
# max_upload_bytes: 42949672960
# build_timeout_minutes: 180
# keep_work_dir: false
# keep_local_artifact: false

# 对象存储种子值（数据库 settings 优先）
# storage:
#   endpoint: https://oss.example.com
#   region: us-east-1
#   bucket: auto-iso
#   prefix: auto-iso
#   access_key: ""
#   secret_key: ""
#   path_style: true
