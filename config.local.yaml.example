# 本地测试用配置示例：复制为 config.local.yaml 后修改。
#
#   cp config.local.yaml.example config.local.yaml
#   chmod 600 config.local.yaml        # 含密码，别让同机其他用户读
#   docker compose -f docker-compose.jdos.yml up -d
#
# 这是本地唯一的配置来源——compose 通过 -c 把它挂进容器。
# 优先级：本文件 > 环境变量 > 默认值。只写需要改的键即可。
# 完整键列表见 deploy/config.example.yaml。

addr: ":8080"

# isos/uploads/work/builds/kickstarts/artifacts 都从 data_dir 派生，无需单独配置
data_dir: /opt/isobuilder/data
log_dir: /export/log/isobuilder

# MySQL（JD 云 RDS）。密码里的 @ 在 URL 形式中要写成 %40。
database_url: 'mysql://isobuilder:REPLACE_PASSWORD@mysql-internet-cn-north-1-415a1725ad4e4162.rds.jdcloud.com:3306/isobuilder'

# PostgreSQL（URL 形式）：
# database_url: 'postgres://user:pass@host:5432/isobuilder?sslmode=prefer'
# PostgreSQL（key=value 形式，密码含 @ 无需转义）：
# database_url: 'host=204.1.2.3 port=5432 user=isobuilder password=secret dbname=isobuilder sslmode=prefer'

# 想用 SQLite（不连外部库）就把 database_url 整行注释掉。
