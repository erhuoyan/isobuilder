# isobuilder 编译基础镜像：openEuler 22.03 LTS + Go 1.26.9 + Node 22.12.0 + pnpm
#
# jdos 用法（制品类型 = 基础镜像）：
#   控制台建原生构建任务（base_image）指向本文件，target=builder；
#   控制台基础镜像选 jdt-jdos-base/jdt-base-os-openeuler22.03lts:latest
#   （jdos 会用控制台选定的镜像替换本文件的 FROM，两者一致正好）；
#   构建产物在「制品管理 - 基础镜像」查看，供应用镜像构建引用。
#
# 本地调试：
#   docker build -t isobuilder-build-base:latest -f Dockerfile.base .

FROM harbor-pro.jd.local/jdt-jdos-base/jdt-base-os-openeuler22.03lts:latest AS builder

# xz 用于解压 Node 的 .tar.xz；git/ca-certificates 供 go mod 与 https 下载使用。
# openEuler 默认源 repo.openeuler.org 即国内源，无需另外换源。
RUN dnf install -y --setopt=install_weak_deps=False \
        xz git ca-certificates && \
    dnf clean all

# Go 1.26.9（SDK 托管在京云内网对象存储，jdos 构建网络可直连）
# GOTOOLCHAIN=local：go.mod 要求 1.26.0，本镜像的 1.26.9 已满足，
# 禁止运行时再去 proxy.golang.org 拉 toolchain（内网拉不到会卡死构建）。
ENV GOTOOLCHAIN=local
RUN curl -fsSL https://s3-internal.cn-north-1.jdcloud-oss.com/0-yunhai-poc/iso-builder/go1.26.9.linux-amd64.tar.gz \
        -o /tmp/go.tgz && \
    rm -rf /lib/go && mkdir -p /lib && \
    tar -xzf /tmp/go.tgz -C /lib && rm -f /tmp/go.tgz
ENV GOROOT=/lib/go \
    PATH=/lib/go/bin:$PATH

# Go module 代理走京东内网 artifactory；海外构建用：
#   docker build --build-arg GOPROXY=https://proxy.golang.org,direct ...
ARG GOPROXY=http://artifactory.jd.com/api/go/go_virtual
ENV GOPROXY=${GOPROXY} GOSUMDB=off

# Node 22.12.0（同样托管在内网对象存储；linux-x64 → 仅支持 x86 架构构建）
RUN curl -fsSL https://s3-internal.cn-north-1.jdcloud-oss.com/0-yunhai-poc/iso-builder/node-v22.12.0-linux-x64.tar.xz \
        -o /tmp/node.tar.xz && \
    rm -rf /lib/node-v22.12.0-linux-x64 && \
    tar -xJf /tmp/node.tar.xz -C /lib && rm -f /tmp/node.tar.xz
ENV PATH=/lib/node-v22.12.0-linux-x64/bin:$PATH

# pnpm：直接 npm 全局安装，绕开 corepack（其签名验证与 npmmirror 镜像源不兼容）
RUN npm install -g pnpm@12.6.0 --registry=https://registry.npmmirror.com
